{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pawch Agent",
  "version": "0.1.0",
  "identifier": "com.agent.local.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Pawch Agent",
        "url": "http://127.0.0.1:5173",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --remote-debugging-port=9223 --remote-debugging-address=127.0.0.1",
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
